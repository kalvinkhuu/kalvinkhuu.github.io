{# index.html.j2 — portfolio website template. Generated into site/index.html. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ meta.site_title }}</title>
<meta name="description" content="{{ meta.site_description }}" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
<style>
  :root {
    --navy: #1a2744;
    --mid: #2d3f6b;
    --accent: #4a7fd4;
    --accent-light: #dce8f8;
    --text: #2c2c2c;
    --muted: #6b7280;
    --border: #dde3ec;
    --bg: #f8f9fc;
    --white: #ffffff;
    --sidebar-w: 260px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── TOP NAV ── */
  header {
    background: var(--navy);
    color: #fff;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
  }
  header .brand {
    font-family: 'Crimson Pro', serif;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: .02em;
    color: #fff;
    text-decoration: none;
  }
  nav { display: flex; gap: 1.6rem; }
  nav a {
    color: rgba(255,255,255,.82);
    text-decoration: none;
    font-size: .82rem;
    font-weight: 500;
    letter-spacing: .04em;
    text-transform: uppercase;
    transition: color .15s;
  }
  nav a:hover { color: #fff; }

  /* ── LAYOUT ── */
  .layout {
    display: flex;
    flex: 1;
    max-width: 1140px;
    margin: 0 auto;
    width: 100%;
    padding: 2.4rem 1.5rem;
    gap: 2.4rem;
    align-items: flex-start;
  }

  /* ── SIDEBAR ── */
  aside {
    width: var(--sidebar-w);
    flex-shrink: 0;
    position: sticky;
    top: 72px;
  }
  .avatar-wrap {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--mid) 0%, var(--accent) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.2rem;
    overflow: hidden;
    border: 4px solid var(--white);
    box-shadow: 0 4px 18px rgba(74,127,212,.28);
  }
  .avatar-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .avatar-initials {
    font-family: 'Crimson Pro', serif;
    font-size: 3.2rem;
    font-weight: 300;
    color: #fff;
    letter-spacing: .04em;
    user-select: none;
  }
  aside h1 {
    font-family: 'Crimson Pro', serif;
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--navy);
    text-align: center;
    line-height: 1.2;
  }
  aside .title {
    text-align: center;
    font-size: .8rem;
    color: var(--muted);
    margin-top: .3rem;
    font-weight: 400;
  }
  aside .institution {
    text-align: center;
    font-size: .82rem;
    color: var(--accent);
    font-weight: 500;
    margin-top: .15rem;
  }

  .cv-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
    margin: 1rem auto 0;
    padding: .45rem .9rem;
    background: var(--navy);
    color: #fff;
    border-radius: 6px;
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: .03em;
    text-decoration: none;
    transition: background .15s;
  }
  .cv-button:hover { background: var(--mid); }
  .cv-button svg { width: 14px; height: 14px; fill: #fff; }

  .contact-list {
    list-style: none;
    margin-top: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }
  .contact-list li {
    display: flex;
    align-items: center;
    gap: .55rem;
    font-size: .8rem;
    color: var(--text);
  }
  .contact-list li a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    word-break: break-all;
  }
  .contact-list li a:hover { text-decoration: underline; }
  .contact-list .icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    fill: var(--muted);
  }

  .sidebar-section {
    margin-top: 1.6rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .sidebar-section h3 {
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: .7rem;
  }
  .tags { display: flex; flex-wrap: wrap; gap: .35rem; }
  .tag {
    background: var(--accent-light);
    color: var(--mid);
    border-radius: 20px;
    padding: .2rem .6rem;
    font-size: .73rem;
    font-weight: 500;
  }
  .lang-list { list-style: none; display: flex; flex-direction: column; gap: .3rem; }
  .lang-list li { font-size: .8rem; color: var(--text); display: flex; justify-content: space-between; }
  .lang-list .lvl { color: var(--muted); font-size: .74rem; }

  /* ── MAIN ── */
  main { flex: 1; min-width: 0; }

  section { margin-bottom: 2.8rem; }

  section h2 {
    font-family: 'Crimson Pro', serif;
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--navy);
    border-bottom: 2px solid var(--accent);
    padding-bottom: .3rem;
    margin-bottom: 1.2rem;
    display: inline-block;
  }

  /* About */
  .about-text {
    font-family: 'Crimson Pro', serif;
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--text);
    font-weight: 300;
    max-width: 700px;
  }
  .about-text + .about-text { margin-top: .9rem; }
  .about-text strong { font-weight: 600; color: var(--navy); }
  .about-text a { color: var(--accent); text-decoration: none; }
  .about-text a:hover { text-decoration: underline; }

  /* Publications */
  .pub-list { display: flex; flex-direction: column; gap: 1.2rem; }
  .pub-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 0 8px 8px 0;
    padding: 1rem 1.2rem;
    transition: box-shadow .2s;
  }
  .pub-card:hover { box-shadow: 0 4px 16px rgba(74,127,212,.12); }
  .pub-venue {
    font-size: .72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--accent);
    margin-bottom: .3rem;
  }
  .pub-venue a { color: inherit; text-decoration: none; }
  .pub-venue a:hover { text-decoration: underline; }
  .pub-title {
    font-family: 'Crimson Pro', serif;
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.35;
    margin-bottom: .4rem;
  }
  .pub-desc { font-size: .82rem; color: var(--muted); line-height: 1.55; }
  .pub-desc + .pub-desc { margin-top: .3rem; }
  .pub-date { font-size: .74rem; color: var(--muted); margin-top: .35rem; }

  /* Education */
  .edu-list { display: flex; flex-direction: column; gap: 1.1rem; }
  .edu-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .edu-card .degree {
    font-family: 'Crimson Pro', serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--navy);
  }
  .edu-card .school { font-size: .84rem; color: var(--accent); font-weight: 500; margin-top: .15rem; }
  .edu-card .details { font-size: .79rem; color: var(--muted); margin-top: .3rem; line-height: 1.5; }
  .edu-card .details a { color: var(--accent); text-decoration: none; }
  .edu-card .details a:hover { text-decoration: underline; }
  .edu-card .period {
    font-size: .78rem;
    color: var(--muted);
    white-space: nowrap;
    margin-top: .15rem;
    text-align: right;
  }
  .gpa-badge {
    display: inline-block;
    background: #e8f4e8;
    color: #2d6a2d;
    border-radius: 4px;
    padding: .1rem .45rem;
    font-size: .75rem;
    font-weight: 600;
    margin-top: .3rem;
  }

  /* Experience */
  .exp-list { display: flex; flex-direction: column; gap: 1.4rem; }
  .exp-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.2rem;
  }
  .exp-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
  .exp-role { font-family: 'Crimson Pro', serif; font-size: 1.05rem; font-weight: 600; color: var(--navy); }
  .exp-org { font-size: .84rem; color: var(--accent); font-weight: 500; }
  .exp-period { font-size: .78rem; color: var(--muted); white-space: nowrap; }
  .exp-bullets { margin-top: .7rem; list-style: none; display: flex; flex-direction: column; gap: .4rem; }
  .exp-bullets li {
    font-size: .83rem;
    color: var(--text);
    padding-left: 1.1rem;
    position: relative;
    line-height: 1.5;
  }
  .exp-bullets li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: .78rem;
  }
  .exp-bullets a { color: var(--accent); text-decoration: none; }
  .exp-bullets a:hover { text-decoration: underline; }
  .exp-bullets .sub { margin-top: .4rem; gap: .3rem; }
  .exp-bullets .sub li::before { content: '·'; font-size: 1rem; top: -.1rem; }

  /* Skills */
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .9rem; }
  .skill-group {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .9rem 1rem;
  }
  .skill-group h4 { font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: .6rem; font-weight: 600; }
  .skill-tags { display: flex; flex-wrap: wrap; gap: .3rem; }
  .skill-tag {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: .18rem .5rem;
    font-size: .74rem;
    color: var(--text);
  }

  /* Projects */
  .proj-list { display: flex; flex-direction: column; gap: 1rem; }
  .proj-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.2rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .proj-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1.1rem;
  }
  .proj-name { font-family: 'Crimson Pro', serif; font-size: 1rem; font-weight: 600; color: var(--navy); }
  .proj-name a { color: inherit; text-decoration: none; }
  .proj-name a:hover { color: var(--accent); }
  .proj-stack { font-size: .74rem; color: var(--accent); margin-top: .15rem; }
  .proj-desc { font-size: .81rem; color: var(--muted); margin-top: .3rem; line-height: 1.5; }
  .proj-period { font-size: .74rem; color: var(--muted); margin-top: .25rem; }

  /* Footer */
  footer {
    text-align: center;
    padding: 1.4rem;
    font-size: .76rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
    background: var(--white);
  }

  @media (max-width: 760px) {
    .layout { flex-direction: column; }
    aside { width: 100%; position: static; }
    .avatar-wrap { width: 120px; height: 120px; }
    nav { gap: .8rem; }
    nav a { font-size: .74rem; }
  }
</style>
</head>
<body>

