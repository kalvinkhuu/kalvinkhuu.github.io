{%- macro icon(key) -%}
<svg class="icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="{{ icons.get(key, icons.link) }}"/></svg>
{%- endmacro -%}

{#- ─────────────────────────── sections ─────────────────────────── #}

{%- macro section_about() %}
      {% for para in about %}
      <p class="about-text">{{ para | rt }}</p>
      {% endfor %}
{%- endmacro %}

{%- macro section_publications() %}
      <div class="pub-list">
        {% for p in publications | visible %}
        <div class="pub-card">
          <div class="pub-venue">
            {%- if p.url is defined %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.venue }} ↗</a>{% else %}{{ p.venue }}{% endif %}
            {%- if p.kind is defined %} · {{ p.kind }}{% endif %}
          </div>
          <div class="pub-title">{{ p.title }}</div>
          {% for h in p.highlights | default([]) | highlights %}
          <div class="pub-desc">{{ h.text | rt }}</div>
          {% endfor %}
          <div class="pub-date">{{ p.date }}</div>
        </div>
        {% endfor %}
      </div>
{%- endmacro %}

{%- macro section_education() %}
      <div class="edu-list">
        {% for e in education | visible %}
        <div class="edu-card">
          <div>
            <div class="degree">{{ e.degree }}</div>
            <div class="school">{{ e.institution }} · {{ e.location }}</div>
            {% set hl = e.highlights | default([]) | highlights %}
            {% if hl %}
            <div class="details">
              {% for h in hl %}{{ h.text | rt }}{% if not loop.last %}<br />{% endif %}{% endfor %}
            </div>
            {% endif %}
            {% if e.gpa is defined %}<span class="gpa-badge">GPA {{ e.gpa }}</span>{% endif %}
          </div>
          <div class="period">{{ e | dates }}</div>
        </div>
        {% endfor %}
      </div>
{%- endmacro %}

{%- macro section_experience() %}
      <div class="exp-list">
        {% for x in experience | visible %}
        <div class="exp-card">
          <div class="exp-header">
            <div>
              <div class="exp-role">{{ x.role }}</div>
              <div class="exp-org">{{ x.organization }} · {{ x.location }}</div>
            </div>
            <div class="exp-period">{{ x | dates }}</div>
          </div>
          {% set hl = x.highlights | default([]) | highlights %}
          {% if hl %}
          <ul class="exp-bullets">
            {% for h in hl %}
            <li>
              {{ h.text | rt }}
              {% if h['items'] %}
              <ul class="exp-bullets sub">
                {% for sub in h['items'] %}<li>{{ sub | rt }}</li>{% endfor %}
              </ul>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
{%- endmacro %}

{%- macro section_skills() %}
      <div class="skills-grid">
        {% for group in skills | visible %}
        <div class="skill-group">
          <h4>{{ group.group }}</h4>
          <div class="skill-tags">
            {% for item in group['items'] %}<span class="skill-tag">{{ item }}</span>{% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
{%- endmacro %}

{%- macro section_projects() %}
      <div class="proj-list">
        {% for p in projects | visible %}
        <div class="proj-card">
          <div class="proj-icon">{{ p.icon | default('◆') }}</div>
          <div>
            <div class="proj-name">
              {%- if p.url is defined %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }} ↗</a>{% else %}{{ p.name }}{% endif %}
              {%- if p.role is defined %} <span style="font-weight:400;color:var(--muted);font-size:.85em;">— {{ p.role }}</span>{% endif %}
            </div>
            <div class="proj-stack">{{ p.stack | default([]) | join(' · ') }}</div>
            {% for h in p.highlights | default([]) | highlights %}
            <div class="proj-desc">{{ h.text | rt }}</div>
            {% endfor %}
            <div class="proj-period">{{ p | dates }}</div>
          </div>
        </div>
        {% endfor %}
      </div>
{%- endmacro %}

{%- set renderers = {
  'about': section_about,
  'publications': section_publications,
  'education': section_education,
  'experience': section_experience,
  'skills': section_skills,
  'projects': section_projects
} -%}

<header>
  <a href="#" class="brand">{{ meta.name }}</a>
  <nav>
    {% for key in layout.web.order %}
    <a href="#{{ key }}">{{ layout.web.titles[key] }}</a>
    {% endfor %}
  </nav>
</header>

<div class="layout">

  <!-- SIDEBAR -->
  <aside>
    <div class="avatar-wrap">
      {% if meta.photo is defined %}
      <img src="{{ meta.photo }}" alt="{{ meta.name }}" />
      {% else %}
      <span class="avatar-initials">{{ meta.name.split() | map(attribute=0) | join }}</span>
      {% endif %}
    </div>
    <h1>{{ meta.name }}</h1>
    <div class="title">{{ meta.headline }}</div>
    <div class="institution">{{ meta.institution }}</div>

    {% if meta.pdf_filename is defined %}
    <a class="cv-button" href="{{ meta.pdf_filename }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="{{ icons.download }}"/></svg>
      Download CV
    </a>
    {% endif %}

    <ul class="contact-list">
      <li>{{ icon('email') }}<a href="mailto:{{ meta.email }}">{{ meta.email }}</a></li>
      {% if meta.phone is defined %}
      <li>{{ icon('phone') }}<span>{{ meta.phone }}</span></li>
      {% endif %}
      {% for p in meta.profiles %}
      <li>{{ icon(p.network | lower) }}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.label | default(p.url) }}</a></li>
      {% endfor %}
      <li>{{ icon('location') }}<span>{{ meta.location }}</span></li>
    </ul>

    {% if research_interests %}
    <div class="sidebar-section">
      <h3>Research Interests</h3>
      <div class="tags">
        {% for tag in research_interests %}<span class="tag">{{ tag }}</span>{% endfor %}
      </div>
    </div>
    {% endif %}

    {% if meta.languages %}
    <div class="sidebar-section">
      <h3>Languages</h3>
      <ul class="lang-list">
        {% for l in meta.languages %}
        <li><span>{{ l.name }}</span><span class="lvl">{{ l.level }}</span></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </aside>

  <!-- MAIN CONTENT -->
  <main>
    {% for key in layout.web.order %}

    <section id="{{ key }}">
      <h2>{{ layout.web.titles[key] }}</h2>
      {{ renderers[key]() }}
    </section>
    {% endfor %}

  </main>
</div>

<footer>
  &copy; {{ year }} {{ meta.name }} · {{ meta.location }} · Generated from
  <code>cv.yaml</code>
</footer>

</body>
</html>
